# Les clés que le banc lit, à copier en `.env` — gitignoré, jamais commité.
# Absentes, les scripts échouent franchement plutôt que de faire semblant.
#
#   source .env
#
# L'app, elle, ne lit rien d'ici : elle est BYOK, les clés se saisissent sur
# l'appareil et vivent chiffrées derrière le Keystore. Une clé dans le build
# serait une clé publiée avec les sources.

export AZURE_SPEECH_KEY=
export AZURE_SPEECH_REGION=
export DEEPSEEK_API_KEY=
export ELEVENLABS_KEY=
